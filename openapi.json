{
  "components": {
    "schemas": {
      "AttendanceIn": {
        "additionalProperties": false,
        "properties": {
          "attending": {
            "type": "boolean"
          },
          "location_id": {
            "type": "integer"
          },
          "meal": {
            "default": 2,
            "maximum": 2,
            "minimum": 0,
            "type": "integer"
          },
          "served_on": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "attending",
          "location_id"
        ],
        "type": "object"
      },
      "GrillAdvanceIn": {
        "additionalProperties": false,
        "properties": {
          "to": {
            "enum": [
              "cooking",
              "ready",
              "collected"
            ],
            "type": "string"
          }
        },
        "required": [
          "to"
        ],
        "type": "object"
      },
      "GrillOrderIn": {
        "additionalProperties": false,
        "properties": {
          "condiments": {
            "default": [],
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "location_id": {
            "type": "integer"
          },
          "main_id": {
            "type": "integer"
          }
        },
        "required": [
          "location_id",
          "main_id"
        ],
        "type": "object"
      },
      "GrillStationIn": {
        "additionalProperties": false,
        "properties": {
          "app_cap": {
            "default": null,
            "maximum": 10,
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          },
          "location_id": {
            "type": "integer"
          },
          "state": {
            "default": null,
            "enum": [
              "accepting",
              "paused",
              "closed",
              null
            ],
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "location_id"
        ],
        "type": "object"
      },
      "HTTPError": {
        "properties": {
          "detail": {
            "type": "object"
          },
          "message": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "KitchenIn": {
        "additionalProperties": false,
        "properties": {
          "passcode": {
            "maxLength": 200,
            "type": "string"
          }
        },
        "required": [
          "passcode"
        ],
        "type": "object"
      },
      "PushSubIn": {
        "additionalProperties": false,
        "properties": {
          "auth": {
            "maxLength": 256,
            "type": "string"
          },
          "endpoint": {
            "maxLength": 1000,
            "type": "string"
          },
          "p256dh": {
            "maxLength": 256,
            "type": "string"
          }
        },
        "required": [
          "auth",
          "endpoint",
          "p256dh"
        ],
        "type": "object"
      },
      "RatingIn": {
        "additionalProperties": false,
        "properties": {
          "comment": {
            "default": null,
            "maxLength": 1000,
            "type": [
              "string",
              "null"
            ]
          },
          "location_id": {
            "type": "integer"
          },
          "recipe_id": {
            "type": "integer"
          },
          "score": {
            "maximum": 5,
            "minimum": 1,
            "type": "integer"
          },
          "served_on": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "location_id",
          "recipe_id",
          "score"
        ],
        "type": "object"
      },
      "SignInIn": {
        "additionalProperties": false,
        "properties": {
          "netid": {
            "enum": [
              "ajw1042",
              "rkc2287",
              "mlp3319",
              "dso4471",
              "hks5508"
            ],
            "type": "string"
          }
        },
        "required": [
          "netid"
        ],
        "type": "object"
      },
      "StockIn": {
        "additionalProperties": false,
        "properties": {
          "location_id": {
            "type": "integer"
          },
          "note": {
            "default": null,
            "maxLength": 140,
            "type": [
              "string",
              "null"
            ]
          },
          "recipe_id": {
            "type": "integer"
          },
          "status": {
            "enum": [
              "low",
              "out"
            ],
            "type": "string"
          }
        },
        "required": [
          "location_id",
          "recipe_id",
          "status"
        ],
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "detail": {
            "properties": {
              "<location>": {
                "properties": {
                  "<field_name>": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          },
          "message": {
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
